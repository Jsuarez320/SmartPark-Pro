      "text-2xl": "24px",
      "text-3xl": "30px"
    },
    "weights": {
      "font-medium": 500,
      "font-semibold": 600,
      "font-bold": 700
    },
    "special": {
      "placa_input": "font-mono font-bold tracking-widest uppercase",
      "recibo_impreso": "Courier New monospace 12px, ancho 80mm",
      "card_labels": "uppercase tracking-wider"
