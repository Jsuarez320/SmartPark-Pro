      "lg": "h-11 (44px)",
      "icon": "h-10 w-10"
    },
    "logo_header": "size-8 (32px)",
    "logo_login": "size-16 (64px)",
    "icon_chip": "size-8 (32px)",
    "icon_box_lg": "size-10 (40px)",
