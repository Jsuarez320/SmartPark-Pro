    "label_input": "space-y-2 (8px)",
    "option_grid": "gap-3 (12px)",
    "table_cell": "py-3 px-3 (12px)",
    "modal_padding": "p-6 (24px) + mx-4 (16px)",
    "card_inner_separator": "space-y-3/4 + border-t/border-b"
