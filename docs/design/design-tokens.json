  },
  "spacing": {
    "scale_base": "4px (Tailwind default)",
    "page_blocks": "space-y-6 (24px)",
    "card_grid": "gap-4 (16px)",
    "card_padding": "p-5 (20px) / p-6 (24px)",
    "form_padding": "p-6 sm:p-8 (24/32px)",
